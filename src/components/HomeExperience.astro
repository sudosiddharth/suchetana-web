---
import { getCollection } from 'astro:content';
import Wa from './Wa.astro';

const entries = await getCollection('projects');
const projects = entries.map((entry) => ({ slug: entry.slug, ...entry.data }));
const projectBySlug = (slug: string) => projects.find((project) => project.slug === slug)!;
const terminals = [
  projectBySlug('2-8-mw-66-11-kv-sub-station'),
  projectBySlug('mro-tek-pvt-ltd'),
  projectBySlug('residential-bungalow-jayanagar'),
];
---
<div class="home-circuit" data-home-circuit>
  <section class="circuit-journey" aria-labelledby="home-title">
    <div class="circuit-stage">
      <div class="field-fallback" aria-hidden="true"></div>

      <figure class="monumental-machine" data-monumental-machine>
        <img src="/electrical/hero-equipment.svg" width="1400" height="1100" alt="A monumental high-tension transformer and switchgear installation, representing Suchetana Electricals’ work from sanctioned supply through commissioning." />
        <figcaption><span>CLASS I ELECTRICAL CONTRACTOR</span><i>ESTABLISHED 1969 · BENGALURU</i></figcaption>
        <div class="commissioning-light" aria-hidden="true"></div>
      </figure>

      <div class="journey-copy">
        <article class="act act-receive is-active" data-act="0">
          <h1 id="home-title">Power, carried<br />all the way through.</h1>
          <p>Suchetana Electricals takes responsibility from sanctioned supply to tested commissioning.</p>
          <div class="hero-actions">
            <a class="brass lg" href="/contact/">Send a project to Madhusudan <span class="ico"><Wa /></span></a>
            <a class="text-link" href="/portfolio/">Enter the Portfolio Film</a>
          </div>
          <div class="range"><span><b>30 KVA</b>Jayanagar residence</span><i></i><span><b>2 × 8 MW</b>Chitradurga sub-station</span></div>
        </article>

      </div>

    </div>
  </section>

  <section class="evidence" aria-labelledby="evidence-title">
    <div class="evidence-rail" aria-hidden="true"><span></span></div>
    <header class="wrap evidence-head">
      <h2 id="evidence-title">The line resolves into proof.</h2>
      <p>Three installations mark the verified range. The complete Project Index contains all 73 records, including locality, connected load and consultant information where recorded.</p>
      <a href="/portfolio/#project-index">Open the complete Project Index</a>
    </header>

    <div class="terminal-projects">
      {terminals.map((project, index) => (
        <a class="terminal-project" href={`/work/${project.slug}`} data-terminal={index}>
          <span class="terminal-node" aria-hidden="true"><i></i></span>
          <div class="terminal-data">
            <p>{index === 0 ? 'State infrastructure' : index === 1 ? 'Commercial installation' : 'Residential installation'}</p>
            <h3>{project.title}</h3>
            <span>{project.locality}</span>
          </div>
          <b>{project.load}</b>
        </a>
      ))}
    </div>

    <a class="film-frame" href="/portfolio/">
      <img src="/photos/image10.jpg" width="1600" height="1200" alt="An open-plan software floor with continuous lighting and workstation power distribution installed by Suchetana Electricals." loading="lazy" />
      <span class="film-shade"></span>
      <span class="film-copy"><b>Completed work,<br />seen at full scale.</b><i>Enter the Portfolio Film</i></span>
    </a>
  </section>

  <section class="licence" aria-labelledby="licence-title">
    <div class="licence-current" aria-hidden="true"><span></span></div>
    <div class="licence-portrait"><img src="/people/madhusudan-ms.jpg" width="1023" height="1537" alt="Madhusudan M.S., proprietor and Class I licence holder of Suchetana Electricals" loading="lazy" /></div>
    <div class="licence-copy">
      <h2 id="licence-title">The current reaches one accountable name.</h2>
      <p>Madhusudan M.S. owns and runs Suchetana Electricals. The Class I contractor licence is held in his name, and every WhatsApp enquiry reaches him directly.</p>
      <div class="licence-plate"><span>CLASS I · ACTIVE PROPRIETOR</span><strong>Madhusudan M.S.</strong><dl><div><dt>Contractor</dt><dd>1CL192563BNG</dd></div><div><dt>Supervisor</dt><dd>1SP191691BNG</dd></div></dl></div>
      <a class="text-link light" href="/team/">See the licence chain and site team</a>
    </div>
  </section>

  <section class="next-project" aria-labelledby="next-title">
    <svg class="next-line" viewBox="0 0 1000 300" aria-hidden="true"><path d="M-20 150H285C360 150 350 64 425 64H690C775 64 770 150 850 150H1020"/><circle cx="850" cy="150" r="14"/></svg>
    <div class="wrap next-grid">
      <div>
        <h2 id="next-title">One terminal remains dark.</h2>
        <p>Your project can begin with a complete drawing set, or only an address. Madhusudan will read what you send and clarify what is needed next.</p>
      </div>
      <div class="project-terminal">
        <header><span>NEW PROJECT</span><b>UNENERGISED</b></header>
        <h3>Your project</h3>
        <dl><div><dt>Known now</dt><dd>Whatever you have</dd></div><div><dt>Issued to</dt><dd>Madhusudan M.S.</dd></div></dl>
        <a class="brass lg" href="/contact/">Prepare the project note <span class="ico"><Wa /></span></a>
        <p>Drawings can be attached after WhatsApp opens.</p>
      </div>
    </div>
  </section>
</div>

<script>
  import { initHomeCircuit } from '../scripts/homeCircuit';
  initHomeCircuit();
</script>

<style>
  .home-circuit{background:#0a090c}.circuit-journey{height:100svh;color:#fff;position:relative}.circuit-stage{height:100svh;position:relative;overflow:hidden;isolation:isolate;background:#09080b}.field-fallback{position:absolute;inset:0;z-index:-4;background:radial-gradient(ellipse at 65% 44%,#17121a 0,#09080b 58%)}
  .monumental-machine{position:absolute;z-index:1;right:-4%;top:7%;width:min(74vw,1320px);height:88%;margin:0;overflow:hidden;pointer-events:none}.monumental-machine::before{content:"";position:absolute;z-index:2;inset:0;background:linear-gradient(90deg,#09080b 0,rgba(9,8,11,.9) 12%,transparent 39%),linear-gradient(0deg,rgba(9,8,11,.85),transparent 34%);pointer-events:none}.monumental-machine img{display:block;width:100%;height:100%;object-fit:contain;object-position:right center;filter:saturate(.72) contrast(1.08) brightness(.72)}.monumental-machine figcaption{position:absolute;z-index:4;right:4%;bottom:4%;display:flex;gap:20px;color:#d0cbd2;font-size:9px;letter-spacing:.13em}.monumental-machine figcaption i{font-style:normal;color:#8d8790}.commissioning-light{position:absolute;z-index:3;inset:-30%;background:linear-gradient(108deg,transparent 39%,rgba(255,255,255,.02) 43%,rgba(200,155,234,.17) 49%,rgba(255,255,255,.05) 53%,transparent 58%);transform:translateX(-70%);mix-blend-mode:screen;pointer-events:none}
  .journey-copy{position:absolute;inset:0;z-index:5;pointer-events:none}.act{position:absolute;left:var(--pad-x);right:auto;top:52%;width:min(610px,41vw);transform:translateY(-48%);opacity:0;visibility:hidden;pointer-events:none}.act::before{content:"";position:absolute;z-index:-1;inset:-64px -100px -64px -24px;background:linear-gradient(90deg,rgba(9,8,11,.99) 68%,transparent);pointer-events:none}.act.is-active{opacity:1;visibility:visible;pointer-events:auto}.act h1,.act h2{font-size:clamp(3.8rem,6.2vw,6rem);line-height:.84;letter-spacing:-.035em;max-width:9ch;text-wrap:balance}.act>p{margin-top:22px;color:#d1ccd4;line-height:1.65;max-width:48ch}.hero-actions{display:flex;align-items:center;gap:18px 28px;flex-wrap:wrap;margin-top:30px}.text-link{color:#fff;font:600 1.05rem var(--disp);text-decoration:none;border-bottom:2px solid var(--glaze-hi);padding-bottom:4px}.range{display:grid;grid-template-columns:auto minmax(50px,160px) auto;align-items:center;gap:16px;margin-top:45px;width:min(100%,620px)}.range span{color:#aaa3ad;font-size:11px}.range b{display:block;color:#fff;font:600 clamp(1.8rem,3.4vw,3.4rem)/1 var(--disp)}.range i{height:1px;background:linear-gradient(90deg,var(--glaze),var(--glaze-hi))}.act-build{left:auto;right:var(--pad-x)}.act-build ul{list-style:none;margin-top:30px;border-top:1px solid #544e57}.act-build li{padding:11px 0;border-bottom:1px solid #403b42;color:#bbb5be;font-size:12px}.act-commission dl{display:flex;gap:clamp(22px,4vw,50px);margin-top:34px}.act-commission dt{font:600 clamp(2.1rem,4vw,4.4rem)/1 var(--disp)}.act-commission dd{margin-top:7px;color:#aaa3ad;font-size:9px;letter-spacing:.1em;text-transform:uppercase}.scroll-instruction{position:absolute;z-index:4;left:var(--pad-x);bottom:27px;color:#918a94;font-size:9px;letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:12px}.scroll-instruction span{width:70px;height:1px;background:var(--glaze-hi)}.journey-meter{position:absolute;z-index:4;right:var(--pad-x);bottom:30px;width:150px;height:2px;background:#413c43}.journey-meter i{display:block;width:100%;height:100%;background:var(--glaze-hi);transform:scaleX(var(--circuit-progress,0));transform-origin:left}
  .evidence{position:relative;background:var(--lime);color:var(--ink);overflow:hidden}.evidence-rail{height:9px;background:var(--zinc-deep);position:relative}.evidence-rail span{position:absolute;inset:0;background:linear-gradient(90deg,var(--glaze),var(--glaze-hi),var(--brass-lit));transform:scaleX(0);transform-origin:left}.evidence-head{padding-top:var(--band);padding-bottom:clamp(50px,7vw,92px);display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.65fr);gap:28px 8vw;align-items:end}.evidence-head h2{font-size:clamp(3.8rem,7.5vw,7.7rem);line-height:.8;letter-spacing:-.035em;max-width:8ch}.evidence-head p{max-width:56ch;color:var(--ink-70);line-height:1.7}.evidence-head a{grid-column:2;color:var(--ink);font:600 1.05rem var(--disp);text-decoration:none;border-bottom:2px solid var(--glaze);justify-self:start}.terminal-projects{border-top:2px solid var(--ink)}.terminal-project{display:grid;grid-template-columns:minmax(74px,10vw) minmax(0,1fr) auto;align-items:center;gap:clamp(20px,4vw,60px);padding:clamp(28px,4vw,58px) var(--pad-x);color:inherit;text-decoration:none;border-bottom:1px solid rgba(22,19,26,.2)}.terminal-node{height:4px;background:var(--zinc-deep);position:relative}.terminal-node i{position:absolute;right:-8px;top:50%;width:16px;height:16px;border:3px solid var(--glaze);border-radius:50%;background:var(--lime);transform:translateY(-50%)}.terminal-data>p{color:var(--glaze);font-size:10px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.terminal-data h3{font-size:clamp(2rem,4.2vw,4.4rem);line-height:.95;margin-top:6px}.terminal-data>span{display:block;margin-top:8px;color:var(--ink-45);font-size:12px}.terminal-project>b{font:600 clamp(1.8rem,4.5vw,4.7rem) var(--disp);text-align:right}.film-frame{min-height:90svh;position:relative;display:flex;align-items:flex-end;overflow:hidden;color:#fff;text-decoration:none}.film-frame img,.film-shade{position:absolute;inset:0;width:100%;height:100%}.film-frame img{object-fit:cover;filter:saturate(.78) contrast(1.06) brightness(.68);transition:transform 1.1s cubic-bezier(.23,1,.32,1)}.film-shade{background:linear-gradient(0deg,rgba(8,7,9,.9),transparent 64%)}.film-copy{position:relative;z-index:1;padding:var(--band) var(--pad-x);display:flex;width:100%;align-items:flex-end;justify-content:space-between;gap:30px}.film-copy b{font:600 clamp(4rem,9vw,9rem)/.78 var(--disp);letter-spacing:-.035em}.film-copy i{font:600 1.1rem var(--disp);font-style:normal;border-bottom:2px solid var(--glaze-hi);padding-bottom:4px}
  .licence{min-height:92svh;position:relative;display:grid;grid-template-columns:minmax(340px,.82fr) minmax(0,1.18fr);background:var(--zinc-dark);color:#fff;overflow:hidden}.licence-portrait{min-height:inherit;position:relative}.licence-portrait::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 58%,var(--zinc-dark)),linear-gradient(0deg,rgba(78,83,89,.55),transparent 36%)}.licence-portrait img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 24%;filter:saturate(.84)}.licence-copy{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:var(--band) var(--pad-x)}.licence-copy h2{font-size:clamp(3.6rem,7vw,7.2rem);line-height:.81;letter-spacing:-.035em;max-width:9ch}.licence-copy>p{margin-top:28px;color:#d4d6d8;max-width:57ch;line-height:1.7}.licence-plate{width:min(100%,680px);margin-top:34px;padding:22px 24px;background:#25282c;border:1px solid #8b9096;box-shadow:0 22px 50px -38px #090a0b}.licence-plate>span{font-size:9px;letter-spacing:.13em;color:var(--glaze-rim)}.licence-plate>strong{display:block;margin-top:11px;font:600 clamp(2rem,4vw,4rem)/1 var(--disp)}.licence-plate dl{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px;padding-top:13px;border-top:1px solid #64696f}.licence-plate dt{color:#afb2b5;font-size:9px;text-transform:uppercase;letter-spacing:.1em}.licence-plate dd{margin-top:4px;font:600 1.1rem var(--disp)}.text-link.light{margin-top:28px}.licence-current{position:absolute;z-index:3;left:0;right:0;top:58%;height:5px;background:#3b3e43}.licence-current span{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--glaze),var(--glaze-hi),var(--brass-lit));transform:scaleX(0);transform-origin:left}
  .next-project{position:relative;background:var(--lime);color:var(--ink);padding:var(--band) 0;overflow:hidden}.next-line{position:absolute;inset:0;width:100%;height:100%;opacity:.16}.next-line path,.next-line circle{fill:none;stroke:var(--glaze);stroke-width:4}.next-grid{position:relative;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr);gap:clamp(42px,8vw,130px);align-items:center}.next-grid h2{font-size:clamp(4rem,8vw,8rem);line-height:.79;letter-spacing:-.035em;max-width:8ch}.next-grid>div:first-child p{margin-top:26px;max-width:55ch;color:var(--ink-70);line-height:1.7}.project-terminal{background:var(--lime);border:2px solid var(--ink);padding:clamp(25px,3.6vw,44px);box-shadow:0 30px 64px -50px var(--ink)}.project-terminal header{display:flex;justify-content:space-between;gap:20px;padding-bottom:12px;border-bottom:1px solid var(--ink);font-size:9px;font-weight:700;letter-spacing:.12em}.project-terminal header b{color:var(--glaze)}.project-terminal h3{font-size:clamp(2.7rem,5vw,5rem);margin-top:24px}.project-terminal dl{margin-top:22px;border-top:1px solid rgba(22,19,26,.3)}.project-terminal dl div{display:flex;justify-content:space-between;gap:20px;padding:10px 0;border-bottom:1px solid rgba(22,19,26,.2);font-size:11px}.project-terminal dt{color:var(--ink-45)}.project-terminal dd{font-weight:600}.project-terminal .brass{margin-top:28px}.project-terminal>p{margin-top:12px;color:var(--ink-45);font-size:10px}
  @media(hover:hover) and (pointer:fine){.terminal-project:hover{color:var(--glaze)}.terminal-project:hover .terminal-node i{background:var(--glaze);box-shadow:0 0 0 7px rgba(88,14,143,.12)}.film-frame:hover img{transform:scale(1.025)}}
  @media(max-width:820px){.circuit-journey{height:100svh;min-height:760px}.circuit-stage{height:100%;min-height:760px}.monumental-machine{right:-23%;top:35%;width:135%;height:62%}.monumental-machine::before{background:linear-gradient(180deg,#09080b 0,transparent 26%),linear-gradient(0deg,rgba(9,8,11,.8),transparent 35%)}.monumental-machine figcaption{display:none}.act{left:var(--pad-x);right:auto;top:12%;width:calc(100% - var(--pad-x)*2);transform:none}.act::before{inset:-24px -18px;background:linear-gradient(180deg,rgba(9,8,11,.99) 76%,transparent)}.act h1,.act h2{font-size:clamp(3.4rem,15vw,5.2rem);max-width:8ch}.act-build{left:var(--pad-x);right:auto}.act-commission dl{flex-wrap:wrap}.range{grid-template-columns:1fr}.range i{width:80px}.evidence-head{grid-template-columns:1fr}.evidence-head a{grid-column:1}.terminal-project{grid-template-columns:44px minmax(0,1fr)}.terminal-project>b{grid-column:2;text-align:left;color:var(--glaze)}.film-frame{min-height:74svh}.film-copy{display:block}.film-copy i{display:inline-block;margin-top:26px}.licence{grid-template-columns:1fr}.licence-portrait{min-height:68svh}.licence-portrait::after{background:linear-gradient(0deg,var(--zinc-dark),transparent 46%)}.licence-current{top:68svh}.next-grid{grid-template-columns:1fr}.project-terminal{width:100%}}
  @media(max-width:500px){.hero-actions{align-items:flex-start;flex-direction:column;gap:14px;margin-top:22px}.hero-actions .brass.lg{font-size:17px;padding:7px 7px 7px 18px}.hero-actions .brass.lg .ico{width:36px;height:36px}.act>p{max-width:36ch;font-size:14px;line-height:1.55}.range{margin-top:28px;gap:10px}.range b{font-size:1.65rem}.terminal-project{padding-top:30px;padding-bottom:30px}.film-copy b{font-size:clamp(3.4rem,17vw,5rem)}.licence-plate dl{grid-template-columns:1fr}.project-terminal header{align-items:flex-start;flex-direction:column}}
  @media(orientation:landscape) and (max-height:620px){.circuit-journey,.circuit-stage{height:calc(100svh - 50px);min-height:430px}.act{top:48%;left:clamp(18px,4vw,42px);width:min(47vw,520px);transform:translateY(-50%)}.act.is-active{opacity:1!important;visibility:visible!important;transform:translateY(-50%)!important}.act h1{font-size:clamp(2.7rem,7.2vw,5.3rem);line-height:.82}.act>p{margin-top:14px;max-width:44ch;font-size:12.5px;line-height:1.45}.hero-actions{margin-top:18px;gap:12px}.hero-actions .brass.lg{font-size:15px;padding:6px 6px 6px 16px}.hero-actions .brass.lg .ico{width:32px;height:32px}.text-link{font-size:.9rem}.range{margin-top:20px;grid-template-columns:auto minmax(35px,90px) auto;gap:10px}.range b{font-size:1.55rem}.monumental-machine{right:-3%;top:4%;width:62%;height:94%}.monumental-machine::before{background:linear-gradient(90deg,#09080b 0,rgba(9,8,11,.82) 8%,transparent 35%),linear-gradient(0deg,rgba(9,8,11,.72),transparent 30%)}}
  @media(orientation:landscape) and (max-height:470px){.act>p{display:none}.range{margin-top:14px}.monumental-machine{width:60%;right:-2%}}
  @media(orientation:landscape) and (max-width:900px){.circuit-stage{isolation:auto}.field-fallback{z-index:0}.monumental-machine{z-index:1}.journey-copy{z-index:5}}
  @media(prefers-reduced-motion:reduce){.circuit-journey{height:auto}.circuit-stage{height:auto;min-height:100svh;position:relative;padding:60px 0 0}.scroll-instruction,.journey-meter{display:none}.monumental-machine{position:relative;right:auto;top:auto;width:100%;height:min(68svh,700px);margin-top:20px}.journey-copy{position:relative}.act,.act.is-active{position:relative;left:auto;right:auto;top:auto;width:auto;transform:none;opacity:1;visibility:visible;padding:64px var(--pad-x);border-bottom:1px solid #49434c}.act-build{left:auto}.evidence-rail span,.licence-current span{transform:scaleX(1)}.film-frame img{transition:none}}
</style>
