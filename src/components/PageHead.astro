---
/** The masthead band each inner page opens on: title, one line, one figure. */
interface Props {
  title: string;
  lede: string;
  figure?: string;
  figureNote?: string;
}
const { title, lede, figure, figureNote } = Astro.props;
---
<header class="phead">
  <div class="wrap">
    <div class="pgrid">
      <div>
        <h1 data-rise>{title}</h1>
        <p data-rise>{lede}</p>
      </div>
      {figure && (
        <div class="fig" data-rise>
          <b>{figure}</b>
          {figureNote && <span>{figureNote}</span>}
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .phead { background: var(--zinc); padding: clamp(46px, 7vw, 96px) 0 clamp(34px, 5vw, 66px); }
  .pgrid {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(20px, 4vw, 60px); align-items: end;
  }
  @media (max-width: 820px) { .pgrid { grid-template-columns: 1fr; gap: 22px; } }

  h1 { font-size: clamp(2.4rem, 6.4vw, 5rem); letter-spacing: -.032em; max-width: 16ch; }
  p {
    margin-top: clamp(14px, 2vw, 22px); max-width: 58ch;
    font-size: clamp(1rem, 1.25vw, 1.14rem); line-height: 1.62; color: var(--ink-80);
  }

  .fig { text-align: right; }
  .fig b {
    display: block; font-family: var(--disp); font-weight: 600;
    font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -.035em; line-height: 1; color: var(--glaze);
  }
  .fig span {
    display: block; margin-top: 8px; font-size: 11px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink-70);
  }
  @media (max-width: 820px) { .fig { text-align: left; } }
</style>
