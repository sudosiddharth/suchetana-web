---
import Wa from './Wa.astro';
---
<section class="accountability" id="firm" aria-labelledby="account-title">
  <div class="portrait">
    <img src="/people/madhusudan-ms.jpg" alt="Madhusudan M.S., proprietor of Suchetana Electricals" width="1023" height="1537" loading="lazy" />
  </div>
  <div class="account-copy">
    <h2 id="account-title">The person who holds the licence is the person who answers.</h2>
    <p>
      Madhusudan M.S. owns and runs Suchetana Electricals. The Class I contractor licence is held
      in his name, and every WhatsApp enquiry reaches him directly—not a sales desk.
    </p>
    <dl>
      <div><dt>Contractor</dt><dd>1CL192563BNG</dd></div>
      <div><dt>Supervisor</dt><dd>1SP191691BNG</dd></div>
      <div><dt>Firm established</dt><dd>1969</dd></div>
    </dl>
    <a class="team-link" href="/team/">Meet the licence holder and the team</a>
  </div>
</section>

<section class="handoff" aria-labelledby="handoff-title">
  <div class="wrap handoff-grid">
    <div>
      <h2 id="handoff-title">A drawing set is useful. An address is enough to begin.</h2>
      <p>Prepare a short project note and send it directly to Madhusudan through WhatsApp.</p>
    </div>
    <div class="title-edge">
      <div><span>PROJECT ENQUIRY</span><b>ISSUED TO</b></div>
      <h3>Madhusudan M.S.</h3>
      <p>Class I contractor · 1CL192563BNG</p>
      <a class="brass lg" href="/contact/">
        Prepare the project note
        <span class="ico"><Wa /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .accountability { min-height:85svh; display:grid; grid-template-columns:minmax(360px,.8fr) minmax(0,1.2fr); background:var(--zinc-dark); color:#fff; }
  .portrait { min-height:inherit; position:relative; overflow:hidden; }
  .portrait::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,transparent 55%,var(--zinc-dark) 100%),linear-gradient(0deg,rgba(78,83,89,.55),transparent 38%); }
  .portrait img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 24%; filter:saturate(.84); }
  .account-copy { display:flex; flex-direction:column; justify-content:center; align-items:flex-start; padding:var(--band) var(--pad-x); }
  .account-copy h2 { font-size:clamp(3rem,6.7vw,6.7rem); line-height:.86; letter-spacing:-.04em; max-width:10ch; }
  .account-copy>p { margin-top:clamp(26px,3.5vw,42px); color:#d2d4d6; max-width:59ch; line-height:1.72; }
  .account-copy dl { width:min(100%,680px); margin-top:36px; border-top:1px solid #858a90; }
  .account-copy dl div { display:flex; justify-content:space-between; gap:24px; padding:12px 0; border-bottom:1px solid #676c72; }
  .account-copy dt { color:#bdc0c3; font-size:11px; text-transform:uppercase; letter-spacing:.1em; }.account-copy dd { font:600 1.2rem var(--disp); }
  .team-link { margin-top:30px; color:#fff; font:600 1.1rem var(--disp); text-decoration:none; border-bottom:2px solid var(--glaze-hi); padding-bottom:3px; }.team-link:hover{color:var(--glaze-rim)}

  .handoff { background:var(--glaze); color:#fff; padding:var(--band) 0; }
  .handoff-grid { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr); gap:clamp(36px,7vw,110px); align-items:center; }
  .handoff h2 { font-size:clamp(3rem,7vw,7rem); line-height:.85; letter-spacing:-.04em; max-width:10ch; }.handoff-grid>div:first-child p{margin-top:24px;color:#e4d5ed;max-width:48ch}
  .title-edge { background:var(--lime); color:var(--ink); padding:clamp(24px,3.5vw,42px); border:2px solid var(--ink); box-shadow:0 30px 60px -42px var(--glaze-deep); }
  .title-edge>div { display:flex;justify-content:space-between;gap:20px;padding-bottom:12px;border-bottom:1px solid var(--ink);font-size:9px;font-weight:700;letter-spacing:.13em; }
  .title-edge h3 { margin-top:24px;font-size:clamp(2rem,4vw,3.8rem); }.title-edge>p{margin-top:7px;color:var(--ink-70);font-size:12px}.title-edge .brass{margin-top:30px}

  @media(max-width:820px){.accountability{grid-template-columns:1fr}.portrait{min-height:66svh}.portrait::after{background:linear-gradient(0deg,var(--zinc-dark),transparent 42%)}.handoff-grid{grid-template-columns:1fr}.title-edge{width:100%}}
</style>
