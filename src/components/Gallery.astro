---
import photos from '../data/photos.json';

type Photo = { src: string; w: number; h: number; alt: string; caption: string; slug?: string; note?: string };
const all = [...(photos.attributed as Photo[]), ...(photos.gallery as Photo[])];
const byFile = (name: string) => all.find((p) => p.src.endsWith(name))!;
const scenes = [
  byFile('image10.jpg'),
  byFile('image34.jpg'),
  byFile('image30.jpg'),
  byFile('image19.jpg'),
  byFile('image43.jpg'),
].filter(Boolean);
const archive = all.filter((p) => !scenes.includes(p));
const lowRes = (p: Photo) => p.w < 900 || p.h < 650;
---
<section class="cinema" id="photographs">
  <header class="opening">
    <div class="openingImage">
      <img src={scenes[0].src} width={scenes[0].w} height={scenes[0].h} alt={scenes[0].alt} fetchpriority="high" decoding="async" />
      <span class="shade"></span>
    </div>
    <div class="openingCopy">
      <h1>Work,<br /><span>energised.</span></h1>
      <p>Nine surviving frames from a fifty-seven-year electrical practice. The photographs lead; the verified register waits behind the index.</p>
    </div>
    <div class="openingMeta">
      <span>Archive frame 01 / 09</span>
      <b>{scenes[0].caption}</b>
    </div>
    <a class="scrollCue" href="#film-2">Enter the film<i></i></a>
  </header>

  <div class="film">
    {scenes.slice(1).map((p, i) => (
      <article class:list={['scene', `scene-${i + 2}`, { placeholder: lowRes(p) }]} id={`film-${i + 2}`}>
        {lowRes(p) && <div class="softField" style={`background-image:url('${p.src}')`}></div>}
        <button
          class="frame"
          type="button"
          data-lightbox-item data-src={p.src} data-alt={p.alt} data-caption={p.caption}
          data-width={p.w} data-height={p.h} aria-label={`Enlarge photograph: ${p.caption}`}
        >
          <img src={p.src} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" />
          <span class="inspect">Open frame</span>
        </button>
        <div class="sceneCopy">
          <span>{String(i + 2).padStart(2, '0')} / 09</span>
          <h2>{p.caption}</h2>
          {lowRes(p)
            ? <p>Archive preview · high-resolution site photograph pending</p>
            : <p>The firm’s own photograph · open to inspect the full uncropped frame</p>}
          {p.slug && <a href={`/work/${p.slug}`}>Read the verified project record</a>}
        </div>
      </article>
    ))}
  </div>

  <section class="archive" aria-labelledby="archive-title">
    <div class="archiveHead">
      <h2 id="archive-title">Remaining frames.</h2>
      <p>Low-resolution source material is kept at an honest scale. Each plate is ready to be replaced by a new site photograph without changing the composition.</p>
    </div>
    <div class="contactStrip">
      {archive.map((p, i) => (
        <figure>
          <button
            type="button" data-lightbox-item data-src={p.src} data-alt={p.alt} data-caption={p.caption}
            data-width={p.w} data-height={p.h} aria-label={`Enlarge photograph: ${p.caption}`}
          >
            <span class="pending">High-resolution frame pending</span>
            <img src={p.src} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" />
          </button>
          <figcaption><span>{String(i + 6).padStart(2, '0')}</span>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="filmClose">
    <p>The photographs are a glimpse.<br />The index is the proof.</p>
    <a href="#project-index" data-open-index>Open all 73 projects</a>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Enlarged project photograph">
    <div class="lightboxShell">
      <div class="lightboxTop">
        <span data-lightbox-count>01 / 09</span>
        <button type="button" data-lightbox-close aria-label="Close photograph"><svg viewBox="0 0 24 24"><path d="m5 5 14 14M19 5 5 19" /></svg></button>
      </div>
      <div class="lightboxStage">
        <button type="button" data-lightbox-prev aria-label="Previous photograph"><svg viewBox="0 0 24 24"><path d="m15 5-7 7 7 7" /></svg></button>
        <img data-lightbox-image src={scenes[0].src} alt={scenes[0].alt} width={scenes[0].w} height={scenes[0].h} />
        <button type="button" data-lightbox-next aria-label="Next photograph"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></button>
      </div>
      <div class="lightboxBottom"><p data-lightbox-caption>{scenes[0].caption}</p><span>← → to move · Esc to close</span></div>
    </div>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const items = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-item]')];
  if (dialog && items.length) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]');
    let active = 0;
    let returnTo: HTMLButtonElement | null = null;
    const show = (index: number) => {
      active = (index + items.length) % items.length;
      const item = items[active]; if (!item || !image || !caption || !count) return;
      image.classList.remove('arrived'); image.src = item.dataset.src ?? ''; image.alt = item.dataset.alt ?? '';
      image.width = Number(item.dataset.width) || 1200; image.height = Number(item.dataset.height) || 800;
      caption.textContent = item.dataset.caption ?? ''; count.textContent = `${String(active + 1).padStart(2,'0')} / ${String(items.length).padStart(2,'0')}`;
      requestAnimationFrame(() => requestAnimationFrame(() => image.classList.add('arrived')));
    };
    items.forEach((item, index) => item.addEventListener('click', () => { returnTo = item; show(index); dialog.showModal(); document.documentElement.classList.add('lightbox-open'); }));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(active - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(active + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(active - 1); if (e.key === 'ArrowRight') show(active + 1); });
    dialog.addEventListener('close', () => { document.documentElement.classList.remove('lightbox-open'); returnTo?.focus({ preventScroll:true }); });
  }
  document.querySelector('[data-open-index]')?.addEventListener('click', (e) => {
    e.preventDefault(); location.hash = 'project-index';
  });
</script>

<style>
  .cinema { --night:#0D0C10; --smoke:#AAA6AF; background:var(--night); color:#fff; }
  .opening { min-height:calc(100dvh - 60px); position:relative; display:grid; overflow:hidden; background:#09090B; }
  .openingImage { position:absolute; inset:0; }
  .openingImage img { width:100%; height:100%; object-fit:cover; filter:saturate(.75) contrast(1.08) brightness(.62); }
  .openingImage .shade { position:absolute; inset:0; background:linear-gradient(90deg,rgba(8,7,10,.94) 0%,rgba(8,7,10,.68) 42%,rgba(8,7,10,.08) 80%),linear-gradient(0deg,rgba(8,7,10,.75),transparent 45%); }
  .openingCopy { position:relative; z-index:2; align-self:center; padding:clamp(110px,15vh,170px) var(--pad-x) 100px; width:min(1400px,100%); margin:auto; }
  .openingCopy h1 { font-size:clamp(5rem,14vw,13rem); line-height:.72; max-width:7ch; letter-spacing:-.035em; text-wrap:balance; }
  .openingCopy h1 span { color:transparent; -webkit-text-stroke:1.5px rgba(255,255,255,.78); }
  .openingCopy p { max-width:50ch; margin-top:clamp(34px,5vw,70px); color:#D4D1D8; font-size:clamp(15px,1.25vw,18px); }
  .openingMeta { position:absolute; z-index:2; right:var(--pad-x); bottom:34px; text-align:right; max-width:38ch; }
  .openingMeta span,.sceneCopy>span { display:block; color:var(--glaze-hi); font-size:10px; letter-spacing:.16em; text-transform:uppercase; }
  .openingMeta b { display:block; margin-top:7px; font-family:var(--disp); font-size:1.2rem; }
  .scrollCue { position:absolute; z-index:2; left:var(--pad-x); bottom:32px; color:#fff; text-decoration:none; font-size:11px; letter-spacing:.13em; text-transform:uppercase; }
  .scrollCue i { display:inline-block; width:64px; height:1px; margin-left:12px; vertical-align:middle; background:var(--glaze-hi); transform-origin:left; animation:pulseLine 1.8s var(--ease) infinite; }
  @keyframes pulseLine { 0%,100%{transform:scaleX(.3);opacity:.45} 50%{transform:scaleX(1);opacity:1} }

  .film { padding:clamp(90px,14vw,220px) 0; overflow:hidden; }
  .scene { min-height:100dvh; position:relative; display:grid; align-items:center; grid-template-columns:repeat(12,minmax(0,1fr)); gap:var(--pad-x); padding:clamp(70px,9vw,130px) var(--pad-x); isolation:isolate; }
  .frame { grid-column:1/9; appearance:none; border:0; padding:0; background:#111; color:#fff; cursor:zoom-in; position:relative; overflow:hidden; box-shadow:0 40px 100px -48px #000; }
  .frame img { display:block; width:100%; height:auto; max-height:78dvh; object-fit:contain; transition:transform 900ms var(--ease),filter 700ms var(--ease); }
  .frame:hover img,.frame:focus-visible img { transform:scale(1.018); filter:brightness(.82); }
  .inspect { position:absolute; right:14px; bottom:14px; padding:8px 11px 6px; background:rgba(13,12,16,.88); font-family:var(--disp); font-size:13px; opacity:0; transform:translateY(8px); transition:opacity 300ms var(--ease),transform 300ms var(--ease); }
  .frame:hover .inspect,.frame:focus-visible .inspect { opacity:1; transform:none; }
  .sceneCopy { grid-column:9/13; align-self:end; padding-bottom:clamp(12px,3vw,48px); }
  .sceneCopy h2 { font-size:clamp(2.4rem,5vw,5.5rem); margin-top:16px; max-width:10ch; }
  .sceneCopy p { margin-top:20px; color:var(--smoke); max-width:36ch; font-size:13px; }
  .sceneCopy a { display:inline-block; margin-top:24px; color:#fff; text-underline-offset:5px; text-decoration-color:var(--glaze-hi); }
  .scene-3 .frame { grid-column:5/13; order:2; }
  .scene-3 .sceneCopy { grid-column:1/5; grid-row:1; }
  .scene-4 .frame { grid-column:2/12; }
  .scene-4 .sceneCopy { grid-column:2/8; grid-row:2; padding-top:24px; }
  .scene-5 .frame { grid-column:6/12; }
  .scene-5 .sceneCopy { grid-column:2/6; grid-row:1; align-self:center; }
  .softField { position:absolute; inset:8% -8%; z-index:-1; background-size:cover; background-position:center; filter:blur(70px) saturate(.65) brightness(.3); opacity:.42; transform:scale(1.08); }
  .placeholder .frame { padding:clamp(18px,3vw,42px); background:#17161B; border:1px solid rgba(255,255,255,.12); }
  .placeholder .frame img { width:auto; max-width:100%; margin:auto; }

  .archive { padding:clamp(90px,12vw,180px) var(--pad-x); background:#121116; }
  .archiveHead { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:end; margin-bottom:50px; }
  .archiveHead h2 { font-size:clamp(3rem,7vw,7rem); }
  .archiveHead p { color:var(--smoke); max-width:52ch; }
  .contactStrip { display:grid; grid-auto-flow:column; grid-auto-columns:minmax(280px,34vw); gap:24px; overflow-x:auto; padding:0 0 24px; scroll-snap-type:x mandatory; scrollbar-color:var(--glaze) #242127; }
  .contactStrip figure { scroll-snap-align:start; }
  .contactStrip button { width:100%; min-height:380px; padding:26px; display:grid; place-items:center; position:relative; background:#1A181E; border:1px solid rgba(255,255,255,.12); color:#fff; cursor:zoom-in; }
  .contactStrip img { max-height:330px; width:auto; object-fit:contain; }
  .pending { position:absolute; left:12px; top:12px; padding:6px 8px 4px; background:var(--glaze); font:600 11px var(--disp); letter-spacing:.05em; }
  .contactStrip figcaption { display:flex; gap:14px; padding-top:12px; color:#D4D1D8; font-family:var(--disp); font-size:1.1rem; }
  .contactStrip figcaption span { color:var(--glaze-hi); }

  .filmClose { min-height:70dvh; display:grid; place-content:center; text-align:center; padding:100px var(--pad-x); }
  .filmClose p { font:600 clamp(3rem,8vw,8rem)/.86 var(--disp); letter-spacing:-.03em; }
  .filmClose a { justify-self:center; margin-top:44px; padding:13px 18px 10px; background:var(--glaze); color:#fff; font:600 17px var(--disp); text-decoration:none; }

  .lightbox { width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:0;border:0;background:rgba(7,7,9,.985);color:#fff; }
  .lightbox::backdrop{background:#070709}.lightboxShell{height:100%;display:grid;grid-template-rows:auto minmax(0,1fr) auto;padding:clamp(14px,2vw,30px)}
  .lightboxTop,.lightboxBottom{display:flex;justify-content:space-between;align-items:center;gap:20px}.lightboxTop>span{color:var(--glaze-hi);font:500 14px var(--disp);letter-spacing:.12em}
  .lightbox button{appearance:none;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.05);color:#fff;cursor:pointer;display:grid;place-items:center;width:48px;height:48px}.lightbox button:hover{background:var(--glaze)}
  .lightbox svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.6}.lightboxStage{min-height:0;display:grid;grid-template-columns:48px minmax(0,1fr) 48px;gap:22px;align-items:center}.lightboxStage img{justify-self:center;max-width:100%;max-height:calc(100dvh - 170px);width:auto;height:auto;object-fit:contain;opacity:0;transform:scale(.94);transition:opacity 420ms var(--ease),transform 700ms var(--ease)}.lightboxStage img.arrived{opacity:1;transform:none}.lightboxBottom p{font:600 clamp(1.1rem,2vw,1.5rem) var(--disp)}.lightboxBottom span{color:#AAA6AF;font-size:10px;letter-spacing:.1em;text-transform:uppercase}:global(html.lightbox-open){overflow:hidden}

  @media(max-width:760px){.openingCopy h1{font-size:clamp(4.6rem,25vw,8rem)}.openingMeta{left:var(--pad-x);right:auto;text-align:left}.scrollCue{display:none}.scene{min-height:auto;display:block;padding:100px var(--pad-x)}.frame{width:100%}.sceneCopy{padding:24px 0 0}.sceneCopy h2{font-size:clamp(2.4rem,13vw,4.8rem)}.archiveHead{grid-template-columns:1fr}.contactStrip{grid-auto-columns:84vw}.lightboxStage{grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr) 48px}.lightboxStage img{grid-column:1/-1;max-height:calc(100dvh - 220px)}.lightboxStage button{width:100%}.lightboxBottom span{display:none}}
  @media(prefers-reduced-motion:reduce){.scrollCue i{animation:none}.frame img,.inspect,.lightboxStage img{transition:none}.frame:hover img,.frame:focus-visible img{transform:none}}
</style>
